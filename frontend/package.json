{
  "name": "blackbox-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:local": "node scripts/dev-local.mjs",
    "db:local": "node scripts/dev-local.mjs --db-only",
    "dev": "node scripts/dev-local.mjs",
    "dev:next": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "rag:ingest": "tsx scripts/rag-ingest.ts",
    "eval": "tsx --conditions=react-server evals/run.ts",
    "eval:langsmith": "tsx --conditions=react-server evals/run.ts --langsmith",
    "check": "npm run typecheck && npm run lint && npm run test",
    "build:deploy": "prisma generate && prisma migrate deploy && prisma db seed && next build",
    "eval:rag": "tsx --conditions=react-server --tsconfig tsconfig.json ../backend/evals/rag_eval.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.0",
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.17",
    "@mediapipe/tasks-vision": "0.10.34",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.7",
    "firebase": "^11.10.0",
    "framer-motion": "^12.34.3",
    "jose": "^6.2.12",
    "langsmith": "0.10.5",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.7.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/dom-speech-recognition": "^0.0.8",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "embedded-postgres": "^17.6.0-beta.15",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "prisma": "^7.10.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19"
  }
}
