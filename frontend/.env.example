# ─────────────────────────────────────────────────────────────────────────────
# Blackbox AI — environment configuration
# Copy to .env.local (never commit .env.local) and fill in real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (PostgreSQL 14+) ────────────────────────────────────────────────
# Local Docker:  docker compose up -d   (see ../docker-compose.yml)
# Managed:       Neon, Supabase, RDS, Cloud SQL… use the pooled TCP URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/blackbox?schema=public"
# Optional: connection pool size per server instance (default 10)
# DATABASE_POOL_SIZE=10

# ── Firebase Authentication (client SDK) ────────────────────────────────────
# Firebase Console → Project settings → Your apps → Web app config.
# Enable the Google, GitHub and/or Phone providers under Authentication.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side ID-token verification uses the project id (no service account
# needed). Defaults to NEXT_PUBLIC_FIREBASE_PROJECT_ID when unset.
# FIREBASE_PROJECT_ID=

# ── Gemini (server-side only) ───────────────────────────────────────────────
# https://aistudio.google.com/app/apikey — never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=
# Comma-separated preference order. The first model that responds is used;
# a 404 (retired model) automatically falls through to the next one.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash

# Optional voice and retrieval models.
# GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts,gemini-2.5-flash-tts
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Set to "off" to skip embeddings (retrieval then uses Postgres full-text only).
# RAG_EMBEDDINGS=on

# ── AI governance ───────────────────────────────────────────────────────────
# Mask emails, phone numbers, Aadhaar/PAN, cards, API keys and names before any
# text reaches Gemini or LangSmith. Leave on in production.
PII_MASKING=on
# One audit row per AI call (feature, outcome, latency, masked counts — no text).
AI_AUDIT_LOG=on

# Irreversible redaction of emails, phones, addresses and government IDs before
# anything is written to PostgreSQL. Leave on in production.
PII_STORAGE_REDACTION=on

# ── RAG ──────────────────────────────────────────────────────────────────────
# Cross-encoder reranker: local (ms-marco-MiniLM-L-6-v2 on the server, default),
# cohere (COHERE_API_KEY, rerank-v3.5), jina (JINA_API_KEY) or off.
# RERANKER=local
# COHERE_API_KEY=
# JINA_API_KEY=
# Minimum cross-encoder relevance (0-1) before the coach answers; below it, it declines.
# RAG_MIN_RELEVANCE=0.05
# Model cache for the local reranker (must be writable; defaults to the OS temp dir).
# TRANSFORMERS_CACHE=

# ── Observability ────────────────────────────────────────────────────────────
# Emails that see global AI metrics (P50/P95 latency, error rates) in Settings.
# ADMIN_EMAILS=you@company.com

# ── LangSmith (tracing + evals) ─────────────────────────────────────────────
# Either the LANGSMITH_* or the legacy LANGCHAIN_* names work:
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=blackbox
# https://smith.langchain.com → Settings → API keys. Traces are masked.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=blackbox
# On serverless hosts (Vercel), flush traces before the function ends:
# LANGSMITH_TRACING_BACKGROUND=false

# ── Local development only ──────────────────────────────────────────────────
# Lets you sign in with a local demo account when Firebase isn't configured.
# Ignored whenever NODE_ENV=production (next build / next start).
# DEV_AUTH_BYPASS=true
# NEXT_PUBLIC_DEV_AUTH_BYPASS=true

# ─── Site ────────────────────────────────────────────────────────────────────
# Public URL, used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional contact address shown on the Terms and Privacy pages.
NEXT_PUBLIC_SUPPORT_EMAIL=
